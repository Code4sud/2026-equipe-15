# Exemple de configuration — copiez en .env (ignoré par git) et remplissez.
# Aucune valeur ici : les secrets ne vont jamais dans le dépôt.

# Port de l'API (8000 par défaut)
# PORT=8000

# Dossier des Rapports des Possibles (PDF), notre « base » de rapports
# (par défaut : prive/ à la racine du dépôt, ignoré par git)
# RAPPORTS_DIR=

# Table jeton -> fichier PDF des liens envoyés par mail
# (par défaut : liens.json dans RAPPORTS_DIR ; remplie par « npm run lien »)
# LIENS_FICHIER=

# Dossier des analyses générées (par défaut : backend/storage)
# BACKEND_STORAGE=storage

# Modèle d'IA local (Ollama), utilisé pour le résumé écrit.
# Sans OLLAMA_MODEL, le résumé est construit sans IA (repli), à partir des
# mêmes faits du rapport.
# Modèle prévu pour la démo : Qwen3.6 (2,35 B), sur le PC de démo. Mettre ici
# son nom exact tel que l'affiche « ollama list ».
# OLLAMA_MODEL=
# Adresse d'Ollama (défaut : http://localhost:11434)
# OLLAMA_URL=
# Délai maximal d'une réponse, en millisecondes (défaut : 90000)
# OLLAMA_TIMEOUT_MS=
# « false » coupe le mode réflexion des modèles Qwen3 (bien plus rapide)
# OLLAMA_THINK=false

# Origines autorisées en CORS (séparées par des virgules, * = toutes, défaut)
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://code4sud.github.io
