# Exemple de configuration — copiez en .env (ignoré par git) et remplissez.
# Aucune valeur ici : les secrets ne vont jamais dans le dépôt.

# Dossier de stockage des PDF déposés et des analyses générées
# (par défaut : backend/storage)
# BACKEND_STORAGE=storage

# Taille maximale d'un PDF accepté, en Mo (20 par défaut)
# MAX_UPLOAD_MO=20

# Configuration du modèle d'IA (partie chat / synthèse, voir services/ai_service.py)
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# Authentification de l'API : si défini, chaque requête doit porter
# le header « Authorization: Bearer <API_TOKEN> ». Laisser vide en dev
# pour désactiver l'auth (les tests automatiques passent alors sans token).
# Générer par exemple avec : python -c "import secrets; print(secrets.token_hex(24))"
# API_TOKEN=

# Origines autorisées en CORS (séparées par des virgules, * = toutes, défaut)
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://code4sud.github.io
