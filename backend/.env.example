# Exemple de configuration — copiez en .env (ignoré par git) et remplissez.
# Aucune valeur ici : les secrets ne vont jamais dans le dépôt.

# Port de l'API (8000 par défaut)
# PORT=8000

# Dossier des Rapports des Possibles (PDF), notre « base » de rapports
# (par défaut : prive/ à la racine du dépôt, ignoré par git)
# RAPPORTS_DIR=

# Ancienne table jeton -> fichier PDF des liens envoyés par mail, lue sans
# être modifiée : ses jetons sont repris dans la base (par défaut : liens.json
# dans RAPPORTS_DIR)
# LIENS_FICHIER=

# Base SQLite des liens (node:sqlite, Node 22.13 ou plus récent) : jetons,
# expiration, révocation, suppression (par défaut : possibles.db à côté de
# liens.json, donc dans prive/, ignoré par git)
# BASE_FICHIER=
# Durée de validité d'un lien, en jours (défaut : 365)
# LIEN_DUREE_JOURS=365

# Mail du lien (npm run envoyer) : écrit dans un fichier .eml, pas envoyé.
# Adresse du site, le lien du mail est <SITE_URL>#/?r=<jeton>
# (défaut : http://localhost:5173/)
# SITE_URL=
# Dossier des mails préparés (défaut : mails/ dans RAPPORTS_DIR, ignoré par git)
# MAILS_DIR=
# Expéditeur affiché (défaut : Possibles.AI <ne-pas-repondre@possibles.invalid>)
# MAIL_EXPEDITEUR=

# Table des métiers O*NET du Centre (.xlsx) : contrôle des métiers et
# recherche de l'onboarding (par défaut : table-metiers-onet-fr-jobzones.xlsx
# dans RAPPORTS_DIR). Absente : l'API marche, sans contrôle ni recherche.
# ONET_FICHIER=

# Dossier des analyses générées (par défaut : backend/storage)
# BACKEND_STORAGE=storage

# Modèle d'IA local (Ollama), utilisé pour le résumé écrit et l'assistant (/chat).
# Sans OLLAMA_MODEL, le résumé est construit sans IA (repli), à partir des
# mêmes faits du rapport, et l'assistant répond qu'il n'est pas disponible.
# Modèle prévu pour la démo : Qwen3.6 35B (qwen3.6:35b), sur le PC de démo.
# Mettre ici son nom exact tel que l'affiche « ollama list ».
# OLLAMA_MODEL=
# Adresse d'Ollama (défaut : http://localhost:11434)
# OLLAMA_URL=
# Délai maximal d'une réponse, en millisecondes (défaut : 90000)
# OLLAMA_TIMEOUT_MS=
# « false » coupe le mode réflexion des modèles Qwen3 (bien plus rapide)
# OLLAMA_THINK=false

# Synthèse vocale locale du résumé (Piper). Sans PIPER_MODELE, pas d'audio :
# le front affiche le texte seul. Binaire et voix hors du dépôt.
# Commande Piper (défaut : « piper » dans le PATH), ou son chemin complet
# PIPER_BIN=
# Chemin du modèle de voix .onnx (son fichier .onnx.json doit être à côté)
# PIPER_MODELE=
# Délai maximal d'une synthèse, en millisecondes (défaut : 120000)
# PIPER_TIMEOUT_MS=

# Origines autorisées en CORS (séparées par des virgules, * = toutes, défaut)
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://code4sud.github.io
